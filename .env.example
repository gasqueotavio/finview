# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis em
# Project Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# URL pública do app (usada no link de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave mestra de criptografia dos campos sensíveis (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA versione, NUNCA perca: sem ela os dados cifrados ficam ilegíveis.
FINVIEW_ENCRYPTION_KEY=

# Notificações push. Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protege a rota do envio agendado (/api/cron/notificacoes). Na Vercel, a mesma variável
# faz o cron mandar "Authorization: Bearer <CRON_SECRET>".
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Chave secreta do Supabase (Project Settings > API Keys > Secret keys). Ignora o RLS:
# usada só no servidor, pelo envio agendado. NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Leitura de boletos com IA (Google Gemini, plano gratuito do Google AI Studio).
# Chave em https://aistudio.google.com/apikey. Só no servidor: NUNCA com prefixo NEXT_PUBLIC_.
# Sem ela, o botão "Ler boleto com IA" não aparece.
GEMINI_API_KEY=
# Modelo "flash" gratuito atual (lista em https://aistudio.google.com/docs/models).
GEMINI_MODEL=gemini-3.6-flash
