# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis em
# Project Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# URL pública do app (usada no link de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave mestra de criptografia dos campos sensíveis (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA versione, NUNCA perca: sem ela os dados cifrados ficam ilegíveis.
FINVIEW_ENCRYPTION_KEY=
